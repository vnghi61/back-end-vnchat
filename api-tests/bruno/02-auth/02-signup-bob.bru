meta {
  name: Signup Bob
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "Bob Bruno",
    "email": "{{bobEmail}}",
    "password": "secret123"
  }
}

script:post-response {
  bru.setVar("bobToken", res.body.token);
  bru.setVar("bobId", res.body._id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
