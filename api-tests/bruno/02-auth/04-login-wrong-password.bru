meta {
  name: Login wrong password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{aliceEmail}}",
    "password": "wrong-password"
  }
}

tests {
  test("400 CHAT-400-015", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("CHAT-400-015");
  });
}
