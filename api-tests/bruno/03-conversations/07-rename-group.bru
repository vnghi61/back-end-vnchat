meta {
  name: Rename group
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/conversations/{{groupId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

body:json {
  {
    "title": "Nhóm Bruno (đổi tên)"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("renamed", function () {
    expect(res.body.title).to.equal("Nhóm Bruno (đổi tên)");
  });
}
