meta {
  name: List inbox
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/conversations?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("has both conversations", function () {
    const ids = res.body.items.map((c) => c._id);
    expect(ids).to.include(bru.getVar("directId"));
    expect(ids).to.include(bru.getVar("groupId"));
  });
}
