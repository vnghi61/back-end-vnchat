meta {
  name: List reminders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/reminders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("contains it", function () {
    expect(res.body.items.some((r) => r._id === bru.getVar("reminderId"))).to.equal(true);
  });
}
