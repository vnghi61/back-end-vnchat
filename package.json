{
  "name": "back-end-vnchat",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "migrate": "node src/scripts/migrate.js",
    "set-roles": "node src/scripts/set-roles.js",
    "test:api": "cd api-tests/bruno && npx --yes @usebruno/cli@4.1.0 run --env local",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "test:db": "docker run -d --name vnchat-test-mongo --tmpfs /data/db -p 127.0.0.1:27018:27017 mongo:7",
    "test:db:stop": "docker rm -f vnchat-test-mongo"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
