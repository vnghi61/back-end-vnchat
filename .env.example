# ---- bắt buộc ----
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/vnchat
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Origin frontend (nhiều origin cách nhau bằng dấu phẩy) – dùng cho CORS HTTP và Socket.IO
CLIENT_URL=http://localhost:5174

# ---- Cloudinary (ảnh/tệp đính kèm, avatar) ----
CLOUDINAR_CLOUD_NAME=
CLOUDINAR_API_KEY=
CLOUDINAR_SECRECT_KEY=
CLOUDINARY_FOLDER=vnchat

# ---- tuỳ chọn (giá trị mặc định) – mô tả đầy đủ: docs/env-reference.md ----
# SESSION_TTL_DAYS=7
# COOKIE_SAMESITE=strict     # strict | lax | none (frontend khác domain mà vẫn dùng cookie → none, luôn kèm Secure)
# VISITOR_SECRET=            # ký visitorToken của khách widget, mặc định = JWT_SECRET
# JSON_BODY_LIMIT=10mb
# TRUST_PROXY=1              # số hop / true / CIDR (Render: 10.0.0.0/8) để rate limit theo IP thật
# WIDGET_ENABLED=true        # mặc định của chat hỗ trợ (admin đổi được trong settings)
# API_DOCS_ENABLED=true      # /api-docs (Scalar)
# FRONTEND_DIST=../frontend/dist   # production: phục vụ SPA nếu thư mục có index.html
# APP_VERSION=               # hiện ở /health (Render: tự lấy RENDER_GIT_COMMIT)

# MESSAGE_MAX_CHARS=8000
# GROUP_MAX_MEMBERS=500
# REACTION_MAX_EMOJI_PER_MESSAGE=20
# PINNED_MESSAGES_MAX=50
# PINNED_CONVERSATIONS_MAX=50
# FORWARD_MAX_TARGETS=10
# POLL_MAX_OPTIONS=10
# REMINDERS_MAX_PER_USER=200
# SUPPORT_TAGS_MAX=20
# FILE_MAX_SIZE_BYTES=26214400
# FILE_ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,application/pdf,...

# RATE_LIMIT_MESSAGES_PER_MINUTE=60
# RATE_LIMIT_LOGIN_PER_MINUTE=20
# RATE_LIMIT_WIDGET_SESSIONS_PER_MINUTE=30
# TYPING_THROTTLE_MS=3000
# PRESENCE_TTL_MS=60000

# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
# SWEEP_INTERVAL_MS=10000
